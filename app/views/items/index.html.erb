<div class="container">
  <div class="row">
    <h1>商品一覧</h1>
      <table>
       <thead>
        <tr>
          <th>ID</th>
          <th>商品名</th>
          <th>販売価格</th>
          <th>ジャンル</th>
          <th></th>
          <th>ステータス</th>
        </tr>
       </thead>
      <% @items.each do |item| %>
       <tbody>
         <tr>
           <td><%= item.id %></td>
           <td><%= link_to item.name, item %></td>
           <td><%= item.price %></td>
           <td><%= item.genre_id %></td>
           <td></td>
           <td><%= item.is_active %></td>
         </tr>
         <% end %>
       </tbody>
      </table>
  </div>
      <% paginate @items%>
</div>
