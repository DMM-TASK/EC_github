<div>
  <%= render "admin/items/header" %>
</div>

<div class="container mt-5 pt-4">

  <div class="row mt-4">
    <div class="col-md-9">
      <h2 class="mb-4">商品一覧</h2>
      <div class="row">
        <% @items.each do |item| %>
          <div class="col-md-3 mb-4">
            <div class="card h-100">
              <% if item.image.attached? %>
                <%= image_tag item.image.variant(resize_to_limit: [100, 100]) %>
              <% else %>
                画像は登録されていません
              <% end %>
              <div class="card-body">
                <h5 class="card-title">
                  <%= link_to item.name, item_path(item.id), class: "text-decoration-none text-dark" %>
                </h5>
                <p class="card-text">¥<%= number_with_delimiter(item.price) %></p>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <div class="pagination justify-content-center">
        <%= paginate @items %>
      </div>
    </div>
  </div>
</div>