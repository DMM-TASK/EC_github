<div class="container">
  <h1>商品一覧</h1>
  <div class="row">
      <table class= "table">
        <thead>
          <tr>
            <th>ID</th>
            <th>商品名</th>
            <th>販売価格</th>
            <th>ジャンル</th>
            <th></th>
            <th>ステータス</th>
          </tr>
         </thead>
      </table>
  </div>
    <% @items.each do |item| %>
  <div calss= "row"> 
    <table> 
        <tbody>
           <tr>
             <td><%= item.id %></td>
             <td><%= link_to item.name, items_path(item.id) %></td>
             <td><%= item.price %></td>
             <td><%= item.genre_id %></td>
             <td></td>
             <td><%= item.is_active %></td>
           </tr>
           <% end %>
         </tbody>
    </table>
</div>
    <% paginate @items %>

