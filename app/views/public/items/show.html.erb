<div><%= render "admin/items/header" %></div>

<h2>商品説明</h2>
<% if @item.image.attached? %>
  <div class="item-image mb-4">
    <%= image_tag @item.image, class: "img-fluid", alt: @item.name %>
  </div>
<% else %>
  <p>画像は登録されていません。</p>
<% end %>
<h2>商品名</h2>
<p><%= @item.name %></p>

<h2>商品説明</h2>
<p><%= @item.introduction %></p>

<h2>ジャンル</h2>
<p><%= @item.genre.name %></p>

<h2>税込価格<br>(税抜価格)</h2>
<p><%= "#{(@item.price * 1.1).to_i}（#{@item.price}）円" %></p>
<p><%= (@item.price * 1.1).floor %>円（<%= @item.price %>円）</p>
<p><%= (@item.price * 1.1).floor %>円（<%= @item.price %>円）</p>

<h2>販売ステータス</h2>
<p><%= @item.is_active ? "販売中" : "販売停止中" %></p>

<%= form_with url: cart_items_path, method: :post, local: false, scope: :cart_item do |f| %>
    <div>
        <%= f.hidden_field :item_id, value: @item.id %><!--form_withの変更、f.追加、_tagを削除、value追加-->
        <%= f.label :amount, "数量" %>
        <%= f.number_field :amount, value: 1, min: 1 %>
    </div>
    <%= f.submit "カートに入れる" %>
<% end %>

