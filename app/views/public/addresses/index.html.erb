<div>
  <%= render "admin/items/header" %>
</div>
<h2 class="mb-4">配送先登録/一覧</h2>

<div class="mb-5">
  <%= form_with model: @address, url: addresses_path, local: true, html: { class: "row g-3" } do |f| %>
    <div class="col-md-4">
      <%= f.label :postal_code, "郵便番号(ハイフンなし)", class: "form-label" %>
      <%= f.text_field :postal_code, class: "form-control" %>
    </div>

    <div class="col-md-4">
      <%= f.label :address, "住所", class: "form-label" %>
      <%= f.text_field :address, class: "form-control" %>
    </div>

    <div class="col-md-4">
      <%= f.label :name, "宛名", class: "form-label" %>
      <%= f.text_field :name, class: "form-control" %>
    </div>

    <div class="col-12">
      <%= f.submit "新規登録", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>

<table class="table table-striped table-bordered">
  <thead class="table-dark">
    <tr>
      <th>宛名</th>
      <th>郵便番号</th>
      <th>住所</th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% @addresses.each do |address| %>
      <tr>
        <td><%= address.name %></td>
        <td><%= address.postal_code %></td>
        <td><%= address.address %></td>
        <td>
          <%= link_to "編集", edit_address_path(address), class: "btn btn-sm btn-warning me-2" %>
          <%= link_to "削除", address_path(address), method: :delete, data: { confirm: "本当に削除しますか？" }, class: "btn btn-sm btn-danger" %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
