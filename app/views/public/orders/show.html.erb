

<div class="container">
<h2 class="bg-gray" >注文履歴詳細</h2>
<div class="row">
  <div class="col-lg-6" mb-5>
    <h2>注文情報</h2>
    <dl class="row mb-5 ">
      <dt class="col-sm-4">注文日</dt>
      <dd class="col-sm-8"><%= @order.created_at.strftime("%Y/%m/%d") %></dd>

      <dt class="col-sm-4">配送先</dt>
      <dd class="col-sm-8">〒<%= @order.postal_code %><br><%= @order.address %><br><%= @order.name %></dd>

      <dt class="col-sm-4">支払方法</dt>
      <dd class="col-sm-8"><%= @order.payment_method_i18n %></dd>

      <dt class="col-sm-4">ステータス</dt>
      <dd class="col-sm-8"><%= @order.status_i18n %></dd>
    </dl>
  </div>

  <div class="col-lg-6">
    <h2>請求情報</h2>
    <dl class="row">
    <dt class="col-sm-4">商品合計</dt>
<dd class="col-sm-8"><%= number_to_currency(@order.order_details.sum { |od| od.price * od.amount }, unit: "¥", precision: 0) %></dd>

<dt class="col-sm-4">配送料</dt>
<dd class="col-sm-8"><%= number_to_currency(@order.shipping_cost, unit: "¥", precision: 0) %></dd>

<dt class="col-sm-4">ご請求額</dt>
<dd class="col-sm-8"><%= number_to_currency(@order.total_payment, unit: "¥", precision: 0) %></dd>
  </div>
</div>



<h2>注文内容</h2>
<table  class="table table-striped" style="width: 50%;">
  <thead>
    <tr>
      <th>商品</th>
      <th>単価（税込）</th>
      <th>個数</th>
      <th>小計</th>
    </tr>
  </thead>
  <tbody>
    <% @order_details.each do |order| %>
   <tr>
    <td><%= order.item.name %></td>
    <td><%= number_to_currency(order.price, unit: "¥", precision: 0) %></td>
    <td><%= order.amount %></td>
    <td><%= number_to_currency(order.price * order.amount, unit: "¥", precision: 0) %></td>
  </tr>
    <% end %>
  </tbody>
</table>
</div>
