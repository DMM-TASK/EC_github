<h2 class="mb-4">注文情報確認</h2>

<table class="table table-bordered">
  <thead class="thead-light">
    <tr>
      <th>商品名</th>
      <th>単価</th>
      <th>数量</th>
      <th>小計</th>
    </tr>
  </thead>
  <tbody>
    <% total = 0 %>
    <% @cart_items.each do |item| %>
      <tr>
        <td><%= item.item.name %></td>
        <td><%= number_to_currency(item.item.price, unit: "¥", precision: 0) %></td>
        <td><%= item.amount %></td>
        <% sub_total = item.item.price * item.amount %>
        <td><%= number_to_currency(sub_total, unit: "¥", precision: 0) %></td>
      </tr>
      <% total += sub_total %>
    <% end %>
    <% shipping_cost = 800 %>
    <tr>
      <td colspan="3" class="text-right font-weight-bold">合計</td>
      <td><%= number_to_currency(total + shipping_cost, unit: "¥", precision: 0) %>（税込・送料<%= number_to_currency(shipping_cost, unit: "¥", precision: 0) %>）</td>
    </tr>
  </tbody>
</table>

<h3 class="mt-5">支払方法</h3>
<p>
  <%= @order.payment_method == "credit_card" ? "クレジットカード" : "銀行振込" %>
</p>

<h3 class="mt-4">お届け先</h3>
<p>〒<%= @order.postal_code %></p>
<p><%= @order.address %></p>
<p><%= @order.name %></p>

<%= form_with model: @order, local: true do |f| %>
  <%= f.hidden_field :payment_method %>
  <%= f.hidden_field :postal_code %>
  <%= f.hidden_field :address %>
  <%= f.hidden_field :name %>
  <%= f.hidden_field :shipping_cost, value: shipping_cost %>
  <%= f.hidden_field :total_payment, value: total + shipping_cost %>
  
  <div class="mt-4">
    <%= f.submit "注文を確定する", class: "btn btn-primary" %>
    <%= link_to "戻る", new_order_path, class: "btn btn-secondary ml-2" %>
  </div>
<% end %>
