<h2 class="mb-4">注文情報入力</h2>
<%= form_with model: @order, url: confirm_orders_path, method: :post, local: true do |f| %> 

  <h3 class="mb-3">支払方法</h3>
  <div class="form-group">
    <div class="form-check">
      <%= f.radio_button :payment_method, 0, class: "form-check-input" %>
      <%= f.label :payment_method, "クレジットカード", value: 0, class: "form-check-label" %>
    </div>
    <div class="form-check">
      <%= f.radio_button :payment_method, 1, class: "form-check-input" %>
      <%= f.label :payment_method, "銀行振込", value: 1, class: "form-check-label" %>
    </div>
  </div>

  <h3 class="mt-4 mb-3">配送先</h3>
  <div class="form-group">
    <div class="form-check">
      <%= f.radio_button :select_address, "own", checked: true, class: "form-check-input" %>
      <%= f.label :select_address_own, "自分の住所", class: "form-check-label" %>
    </div>
    <div class="form-check">
      <%= f.radio_button :select_address, "registered", class: "form-check-input" %>
      <%= f.label :select_address_registered, "登録済みの配送先から選択", class: "form-check-label" %>
    </div>
    <div class="mt-2">
      <%= f.collection_select(:address_id, @addresses, :id, :address, prompt: "配送先を選択") %> <!--メンターさんと一緒に変更した部分です-->
    </div>
    <div class="form-check mt-3">
      <%= f.radio_button :select_address, "new", class: "form-check-input" %>
      <%= f.label :select_address_new, "新しい配送先を入力", class: "form-check-label" %>
    </div>


    <div class="form-group mt-2">
      <%= f.label :name, "宛名" %>
      <%= f.text_field :name, class: "form-control" %>
    </div>
    <div class="form-group">
      <%= f.label :postal_code, "郵便番号" %>
      <%= f.text_field :postal_code, class: "form-control" %>
    </div>
    <div class="form-group">
      <%= f.label :address, "住所" %>
      <%= f.text_field :address, class: "form-control" %>
    </div>
  </div>

  <div class="mt-4">
    <%= f.submit "確認画面へ", class: "btn btn-primary" %>
  </div>

<% end %>
