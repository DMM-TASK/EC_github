<div class="container">
  <div class="row">
    <div class="col">
      <h4 class="my-5"><%= @customer.full_name %>さんの会員情報編集</h4>
      <%= form_with model:@customer, url: update_customer_path(@customer), method: :patch, local: false do |f| %>
      <table class="table table-borderless">
        <tr>
          <td>会員ID</td>
          <td><%= @customer.id %></td>
        </tr>
        
        <tr>
          <td>氏名</td>
          <td>
            <%= f.text_field :first_name, class: "form-control d-inline w-25" %> 
            <%= f.text_field :last_name, class: "form-control d-inline w-25 ms-2" %>
          </td>
        </tr>

        <tr>
          <td>フリガナ</td>
          <td>
            <%= f.text_field :first_name_kana, class: "form-control d-inline w-25" %> 
            <%= f.text_field :last_name_kana, class: "form-control d-inline w-25 ms-2" %>
           </td>
        </tr>

        <tr>
          <td>郵便番号</td>
          <td><%= f.text_field :postal_code, class: "form-control" %></td>
          <td></td>
        </tr>

        <tr>
          <td>住所</td>
          <td><%= f.text_field :address, class: "form-control" %></td>
          <td></td>
        </tr>

        <tr>
          <td>電話番号</td>
          <td><%= f.text_field :telephone_number, class: "form-control" %></td>
          <td></td>
        </tr>

        <tr>
          <td>メールアドレス</td>
          <td><%= f.text_field :email, class: "form-control" %></td>
          <td></td>
        </tr>
        
        <tr>
          <td>会員ステータス</td>
          <td><%= link_to "退会する？",unsubscribe_customer_path, class:'btn btn-danger ms-3' %></td>
        </tr>

        <tr>
          <td><%= link_to "Back", customer_path(current_customer), class:'btn ms-3'%></td>
          <td><%= f.submit "変更を保存", class:"btn btn-success" %></td>
        </tr>
      </table>
      <% end %>
    </div>
  </div>
</div>