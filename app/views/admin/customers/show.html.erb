<%= render 'admin/items/header' %>

<% if flash[:notice] %>
  <div class="alert alert-success text-center flash-message">
    <%= flash[:notice] %>
  </div>
<% end %>
<div class="container mt-4">
    <div class="row">
      <div class="mb-4" style="background-color: #e9ecef;">
        <h3 class="mb-0"><%= @customer.last_name %><%= @customer.first_name %>さんの会員詳細</h3>
      </div>
    </div>
    <div class="row mt-4">
      <table class="table table-borderless">
        <tbody>
          <tr>
            <th>会員ID</th>
            <td><%= @customer.id %></td>
          </tr>
          <tr>
            <th>氏名</th>
            <td><%= @customer.last_name %><%= @customer.first_name %></td>
          </tr>
          <tr>
            <th>フリガナ</th>
            <td><%= @customer.last_name_kana %><%= @customer.first_name_kana %></td>
          </tr>
          <tr>
            <th>郵便番号</th>
            <td><%= @customer.postal_code %></td>
          </tr>
          <tr>
            <th>住所</th>
            <td><%= @customer.address %></td>
          </tr>
          <tr>
            <th>電話番号</th>
            <td><%= @customer.telephone_number %></td>
          </tr>
          <tr>
            <th>メールアドレス</th>
            <td><%= @customer.email %></td>
          </tr>
          <tr>
            <th>会員ステータス</th>
            <% if @customer.is_active %>
              <td><span class="text-success">有効</span></td>
            <% else %>
              <td><span class="text-secondary">退会</span></td>
            <% end %>
          </tr>
            <th></th>
            <td>
              <%= link_to "編集する", edit_admin_customer_path(@customer), class: "btn btn-success mr-5" %>
              <%= link_to "注文履歴一覧を見る", admin_root_path, class: "btn btn-primary" %>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
</div>