<%= render 'admin/items/header' %>
<div class="container mt-4">
  <div class="row">
    <div class="mb-4" style="background-color: #e9ecef;">
      <h3 class="mb-0"><%= @customer.last_name %><%= @customer.first_name %>さんの会員情報編集</h3>
    </div>
  </div>
      <%= form_with model: @customer, url:admin_customer_path, method: :patch do |f| %>
    <div class="row mt-4">
      <table class="table table-borderless">
        <tbody>
          <tr>
            <th>会員ID</th>
            <td><%= @customer.id %></td>
          </tr>
          <tr>
            <th>氏名</th>
            <td>
              <%= f.text_field :last_name,  class: "form-control d-inline-block w-auto mr-4 border border-dark" %> 
              <%= f.text_field :first_name, class: "form-control d-inline-block w-auto border border-dark" %>
            </td>
          </tr>
          <tr>
            <th>フリガナ</th>
            <td>
              <%= f.text_field :last_name_kana,  class: "form-control d-inline-block w-auto mr-4 border border-dark"  %>
              <%= f.text_field :first_name_kana, class: "form-control d-inline-block w-auto border border-dark" %>
            </td>
          </tr>
          <tr>
            <th>郵便番号</th>
            <td><%= f.text_field :postal_code, class: "form-control w-auto border border-dark" %></td>
          </tr>
          <tr>
            <th>住所</th>
            <td><%= f.text_field :address, class: "form-control border border-dark w-75" %></td>
          </tr>
          <tr>
            <th>電話番号</th>
            <td><%= f.text_field :telephone_number, class: "form-control w-auto border border-dark" %></td>
          </tr>
          <tr>
            <th>メールアドレス</th>
            <td><%= f.text_field :email, class: "form-control w-auto border border-dark" %></td>
          </tr>
          <tr>
            <th>会員ステータス</th>
            <%= form_with model: @customer, url:admin_customer_path, method: :patch do |f| %>
            <td>
              <%= f.radio_button :is_active, true %>
              <%= f.label :is_deleted, '有効' %>
              <%= f.radio_button :is_active, false %>
              <%= f.label :is_deleted, '退会' %>
            </td>
            <% end %>
          </tr>
          <th>
            <td><%= f.submit '変更を保存', class: "btn btn-success" %></td>
          </th>
        </tbody>
      </table>
    </div>
    <% end %>
  </div>