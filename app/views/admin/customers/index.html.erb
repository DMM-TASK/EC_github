<%= render 'admin/items/header' %>

<div class="container mt-4">
  <div class="row">
    <div class="mb-4" style="background-color: #e9ecef;">
      <h3 class="mb-0">会員一覧</h3>
    </div>
  </div>
  <div class="row mt-4">
      <table class="table">
        <thead class="table-active">
          <tr>
            <th>会員ID</th>
            
            <th>氏名</th>
            
            <th>メールアドレス</th>
            
            <th>ステータス</th>
          </tr>
        </thead>
        <tbody>
          <% @customers.each do |customer| %>
            <tr>
              <td><%= customer.id %></td>
              <td>
                <%= link_to admin_customer_path(customer.id), style: "text-decoration: underline;" do %>
                  <%= customer.last_name %><%= customer.first_name %>
                <% end %>
              </td>
              <td><%= customer.email %></td>
              <td>
                <% if customer.is_active %>
                  <span class="text-success">有効</span>
                <% else %>
                  <span class="text-secondary">退会</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
  </div>
</div>
<div class="d-flex justify-content-center">
  <%= paginate @customers %>
</div>