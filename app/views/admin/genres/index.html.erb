<%= render 'admin/items/header' %>

<div class="container mt-4">
  <div class="row">
    <div class="mb-4" style="background-color: #e9ecef;">
      <h3 class="mb-0">ジャンル一覧・追加</h3>
    </div>
  </div>

  <div class="row mt-4">
    
      <%= form_with model: @genre, url: admin_genres_path, method: :post, local: true do |f| %>
      <table class="table table-borderless">
        <tbody>
          <tr>
            <th>ジャンル名</th>
            <td></td>
            <td><%= f.text_field :name, placeholder: "ジャンル名" %></td>
            <td></td>
            <td><%= f.submit "新規登録",class:"btn btn-success" %></td>
          </tr>
        </tbody>
      </table>
      <% end %>
    
  </div>

  <div class="row">
    <table class="table col-5">
      <thead class="table-active">
        <tr>
          <th></th>
          <th>ジャンル</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @genres.each do |genre| %>
          <tr>
            <td><%= genre.name %></td>
            <td></td>
            <td><%= link_to "編集する",edit_admin_genre_path(genre.id),class:'btn btn-success' %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>

