<%= render 'header' %>
 <h4 class="mb-4 mt-2 bg-gray" style="width: 200px;">商品新規投稿</h4>

<div class="col-lg-4 mx-auto">

  <% if @item.errors.any? %>
    <div class="alert alert-danger">
      <p><%= @item.errors.count %>件のエラーが発生しました</p>
      <ul>
        <% @item.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form_with model: @item, url: admin_items_path, local: true do |f| %>
    <div class="mb-3">
      <%= f.label :image, "商品画像" %>
      <%= f.file_field :image, accept: "image/*", class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :name, "商品名" %>
      <%= f.text_field :name, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :introduction, "商品説明" %>
      <%= f.text_area :introduction, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :genre_id, "ジャンル" %>
      <%= f.collection_select :genre_id, @genres, :id, :name, { prompt: "選択してください" }, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :price, "税抜き価格" %>
      <%= f.text_field :price, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :is_active, "販売ステータス" %><br>
      <div class="form-check form-check-inline">
        <%= f.radio_button :is_active, true, id: :is_active_true, class: "form-check-input" %>
        <%= f.label :is_active_true, "有効", class: "form-check-label" %>
      </div>
      <div class="form-check form-check-inline">
        <%= f.radio_button :is_active, false, id: :is_active_false, class: "form-check-input" %>
        <%= f.label :is_active_false, "無効", class: "form-check-label" %>
      </div>
    </div>

    <%= f.submit '新規登録', class: "btn btn-success mt-3" %>
  <% end %>
</div>