<h2>商品説明</h2>

<h4>商品画像</h4>
<% if @item.image.attached? %>
  <%= image_tag @item.image.variant(resize_to_limit: [300, 300]) %>
<% else %>
  <p>画像は登録されていません</p>
<% end %>

<h4>商品名</h4>
<p><%= @item.name %></p>

<h4>商品説明</h4>
<p><%= @item.introduction %></p>

<h4>ジャンル</h4>
<p><%= @item.genre.name %></p>

<h4>税込価格<br>(税抜価格)</h4>
<p><%= "#{(@item.price * 1.1).to_i}（#{@item.price}）円" %></p>

<h4>販売ステータス</h4>
<p><%= @item.is_active ? "販売中" : "販売停止中" %></p>

<%= link_to "編集する", edit_admin_item_path(@item.id) %>