<%= render 'header' %>

<div class="container">
<div class="row">
<div class="col-lg-10 mx-auto">

<div class="d-flex align-items-center justify-content-between mb-3 ">
  <h2 class="me-5 mb-0 mt-2 bg-gray">商品一覧</h2>
  <%= link_to new_admin_item_path, class: "btn btn-success ms-auto" do %>
    <i class="fa-solid fa-plus me-1"></i> 
  <% end %>
</div>

<table class="table table-striped table-hover">
  <thead>
  <tr>
    <th>商品ID</th>
    <th>商品名</th>
    <th>税抜価格</th>
    <th>ジャンル</th>
    <th>ステータス</th>
  </tr>
  </thead>
  <tbody>
  <% @items.each do |item| %>
  <tr>
    <td><%= item.id %></td>
    <td><%= link_to item.name, admin_item_path(item) %></td>
    <td><%= item.price %></td>
    <td><%= item.genre.name %></td>
    <td><%= item.status_text %></td>
  </tr>
  <% end %>
  </tbody>
</table>

<%= paginate @items %>

</div>
</div>
</div>