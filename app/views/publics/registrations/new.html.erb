
<div class="container">
  <div class="row">
    <div class="col-sm-12 col-md-8 col-lg-5 px-5 px-sm-0">
      <h1>会員用</h1>
      <h2>Sign up</h2>
      <%= form_with model: @customer, url: customer_registration_path do |f| %>
        <%= render "admins/shared/error_messages", resource: resource %>
      
        <div class="field">
          <%= f.label :姓 %><br/>
          <%= f.text_field :first_name, autofocus: true, class: "form-control d-inline w-25", placeholder:"姓" %>
        </div>
        <div class="field">
          <%= f.label :名 %><br/>
          <%= f.text_field :last_name, autofocus: true, class: "form-control d-inline w-25",placeholder:"名" %>
        </div>
        <div class="field">
          <%= f.label :姓（カナ） %><br/>
          <%= f.text_field :first_name_kana, autofocus: true, class: "form-control d-inline w-25",placeholder:"姓（カナ）" %>
        </div>
        
        <div class="field">
          <%= f.label :名（カナ） %><br>
          <%= f.text_field :last_name_kana, autofocus: true, class: "form-control d-inline w-25", placeholder:"名（カナ）" %>
        </div>

        <div class="field">
          <%= f.label :郵便番号 %><br>
          <%= f.text_field :postal_code, autofocus: true, class: "form-control", imputmode: "numeric", pattern: "[0-9]*", placeholder:"半角で記入" %>
        </div>

        <div class="field">
          <%= f.label :住所 %><br>
          <%= f.text_field :address, autofocus: true, class: "form-control", placeholder:"住所"%>
        </div>

        <div class="field">
          <%= f.label :電話番号 %><br>
          <%= f.text_field :telephone_number, autofocus: true, class: "form-control", imputmode: "numeric", pattern: "[0-9]*", placeholder:"半角で記入" %>
        </div>

        <div class="field">
          <%= f.label :メールアドレス %><br/>
          <%= f.email_field :email, autofocus: true, class: "form-control", placeholder:"メールアドレス"%>
        </div>
      
        <div class="field">
          <%= f.label :パスワード %>
          <% if @minimum_password_length %>
          <em>(<%= @minimum_password_length %> characters minimum)</em>
          <% end %><br />
          <%= f.password_field :password, autocomplete: "new-password", class: "form-control" %>
        </div>
      
        <div class="field">
          <%= f.label :再度パスワード入力 %><br />
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
        </div>
      
        <div class="actions">
          <%= f.submit "Sign up" %>
        </div>
      <% end %>
      
      <%= render "admins/shared/links" %>
    </div>
  </div>
</div>

