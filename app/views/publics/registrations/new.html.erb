<div>
  <%= render 'admin/items/header' %>
</div>

<div class="containerm my-5">
  <div class="row justify-content-center">
    <div class="col-sm-12 col-md-8 col-lg-6">
      <h2 class="mb-4">新規会員登録</h2>
      <%= form_with model: @customer, url: customer_registration_path do |f| %>
        <%= render "admins/shared/error_messages", resource: resource %>
      
        <div class="mb-3 row">
          <label class="col-sm-3 col-form-label">氏名</label>
          <div class="col-sm-4">
            <%= f.text_field :last_name, class: "form-control", placeholder: "姓" %>
          </div>
          <div class="col-sm-4">
            <%= f.text_field :first_name, class: "form-control", placeholder: "名" %>
          </div>
        </div>
        
        <div class="mb-3 row">
          <label class="col-sm-3 col-form-label">氏名（カナ）</label>
          <div class="col-sm-4">
            <%= f.text_field :last_name_kana, class: "form-control", placeholder: "セイ" %>
          </div>
          <div class="col-sm-4">
            <%= f.text_field :first_name_kana, class: "form-control", placeholder: "メイ" %>
          </div>
        </div>

        <div class="mb-3 row">
          <label class="col-sm-3 col-form-label">郵便番号</label>
          <div class="col-sm-9">
            <%= f.text_field :postal_code, class: "form-control", inputmode: "numeric", pattern: "[0-9]*", placeholder: "例：1234567（半角数字）" %>
          </div>
        </div>

        <div class="mb-3 row">
          <label class="col-sm-3 col-form-label">住所</label>
          <div class="col-sm-9">
            <%= f.text_field :address, class: "form-control", placeholder: "例：埼玉県さいたま市〜" %>
          </div>
        </div>

        <div class="mb-3 row">
          <label class="col-sm-3 col-form-label">電話番号</label>
          <div class="col-sm-9">
            <%= f.text_field :telephone_number, class: "form-control", inputmode: "numeric", pattern: "[0-9]*", placeholder: "09012345678（半角数字）" %>
          </div>
        </div>

        <div class="mb-3 row">
          <label class="col-sm-3 col-form-label">メールアドレス</label>
          <div class="col-sm-9">
            <%= f.email_field :email, class: "form-control", placeholder: "example@example.com" %>
          </div>
        </div>

        <div class="mb-3 row">
          <label class="col-sm-3 col-form-label">パスワード</label>
          <div class="col-sm-9">
            <% if @minimum_password_length %>
              <small class="text-muted">（<%= @minimum_password_length %>文字以上）</small>
            <% end %>
            <%= f.password_field :password, class: "form-control", autocomplete: "new-password" %>
          </div>
        </div>

        <div class="mb-4 row">
          <label class="col-sm-3 col-form-label">再度パスワード</label>
          <div class="col-sm-9">
            <%= f.password_field :password_confirmation, class: "form-control", autocomplete: "new-password" %>
          </div>
        </div>
      
        <div class="actions">
          <%= f.submit "新規登録", class: "btn btn-primary px-5" %>
        </div>
      <% end %>
      
      <div class="text-center mt-4">
        <p>すでにログイン済みの方は
          <%= link_to "こちらからログイン", new_customer_session_path, class: "text-decoration-underline" %>
        </p>
      </div> 
    </div>
  </div>
</div>

